# LinkAPI: right panel text-based math tutoring
LINKAPI_BASE_URL=https://linkapi.ai/v1
LINKAPI_MODEL=gpt-6-sol
LINKAPI_API_KEY=your_linkapi_api_key

# VolcEngine: official Web SDK direct AK/SK authentication
# In this local demo, Python returns these values to the browser at runtime.
VOLC_ACCESS_KEY_ID=your_volcengine_access_key_id
VOLC_SECRET_ACCESS_KEY=your_volcengine_secret_access_key

# Public HTTPS image URL configured for the VolcEngine avatar service
VOLC_AVATAR_IMAGE_URL=https://example.com/your-avatar.jpg
VOLC_AVATAR_SPEAKER=saturn_zh_female_aojiaonvyou_tob
# Optional: leave blank to use the math teacher prompt in app.py
VOLC_AVATAR_USER_PROMPT=
